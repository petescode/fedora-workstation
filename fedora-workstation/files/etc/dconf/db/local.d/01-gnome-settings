# documentation website for GNOME is abandoned, but this is maintained:
# https://gitlab.gnome.org/GNOME/gnome-user-docs/-/tree/master?ref_type=heads

# To discover what gsetting a GUI is modifying, open a terminal and run: "dconf watch /"
#   then make changes in the GUI

# Nautilus on Fedora 42 (with GNOME 48) uses this legacy gtk setting
[org/gtk/settings/file-chooser]
sort-directories-first=true
show-hidden=true

# does not appear to affect Nautilus in GNOME 48
#[org/gtk/gtk4/settings/file-chooser]
#sort-directories-first=true
#show-hidden=true

[org/gnome/desktop/interface]
clock-format='24h'
color-scheme='prefer-dark'
document-font-name='DejaVu Sans 11'
font-name='DejaVu Sans 11'
icon-theme='Papirus'
# gtk-theme affects legacy applications still using gtk and not gtk4
#  these include terminator, Virtual Machine Manager, and others
gtk-theme='HighContrastInverse'
monospace-font-name='DejaVu Sans Mono 11'

# GUI correlations:
# idle-delay = Power --> Power Saving --> Automatic Screen Blank
# note: this one setting controls both GUI settings; setting it to 0 makes the GUI toggle turn off
[org/gnome/desktop/session]
idle-delay=uint32 1800

# GUI correlations:
#   NOTE: GUI does not show this in GNOME 49, see Known Issues in CHANGELOG
# sleep-inactive-ac-type = Power --> Power Saving --> Automatic Suspend toggle ('suspend' = on, 'nothing' = off)
# sleep-inactive-ac-timeout = Power --> Power Saving --> Automatic Suspend --> Delay
[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='suspend'
sleep-inactive-ac-timeout=10800

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:appmenu'
titlebar-font='DejaVu Sans Bold 11'

# Nautilus = the file manager
[org/gnome/nautilus/preferences]
default-folder-viewer='list-view'
thumbnail-limit='100'

[org/gnome/shell]
favorite-apps=['org.mozilla.firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.keepassxc.KeePassXC.desktop', 'virt-manager.desktop', 'code.desktop', 'org.gnome.Calculator.desktop']

# Terminator keybinding shortcut
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
binding='<Control>t'
command='terminator'
name='terminal'